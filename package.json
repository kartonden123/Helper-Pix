{
  "name": "majestic-catalog-overlay",
  "version": "3.1.13",
  "description": "Helper Pix by KATO",
  "main": "main.js",
  "author": "Pix™",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.majestic.catalog.overlay",
    "productName": "Polix Helper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "data.js",
      "ak.js",
      "notice.js",
      "split.js",
      "poker.js",
      "chat.js",
      "look.js",
      "tools.js",
      "tools2.js",
      "memo.js",
      "settings.js",
      "online.js",
      "protect.js",
      "persist.js",
      "laws.js",
      "rules.js",
      "ustavy.js",
      "extras.js",
      "extras2.js",
      "anim.js",
      "ai.js",
      "staff.js",
      "updater-ui.js",
      "logo.png",
      "auth.js",
      "login.html",
      "tray.png"
    ],
    "publish": {
      "provider": "github",
      "owner": "kartonden123",
      "repo": "Helper-Pix",
      "releaseType": "release"
    },
    "win": {
      "legalTrademarks": "Pix™",
      "icon": "icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Helper Pix",
      "artifactName": "HelperPix-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ws": "^8.22.1"
  }
}
